RED=$'\033[38;5;31m'
ORANGE=$'\033[1;38;5;209m'
PINK=$'\033[1;38;5;204m'
PEACH=$'\033[1;38;5;223m'
GREEN=$'\033[1;32m'
NC=$'\033[0m'

if [ -n "${BASH_VERSION-}" ] && [ -f "$HOME/.inputrc" ]; then
	case $- in
		*i*) bind -f "$HOME/.inputrc" ;;
	esac
fi

#   Git
gits()
{
	git fetch origin || return
	git status --short --branch "$@"
}

gitl()
{
	if [ "$#" -eq 0 ]; then
		git log --graph --decorate --oneline --all -20
	else
		git log --graph --decorate --oneline --all "$@"
	fi
}

#   Reload shell configuration
rsource()
{
	local shell_name

	if [ -n "${ZSH_VERSION-}" ]; then
		shell_name=zsh
	elif [ -n "${BASH_VERSION-}" ]; then
		shell_name=bash
	else
		printf '%s\n' "rsource supports Bash and Zsh only." >&2
		return 1
	fi

	. "$HOME/.${shell_name}rc" || return
}

#   Git helpers
gclyf()
{
	printf '%s\n' "${PEACH}------------------------------------------------------------${NC}"
	printf '%s' "$ORANGE"
	git clone "git@github.com:Lyphmeno/$1.git"
	local git_status=$?
	printf '%s' "$NC"
	printf '%s\n' "${PEACH}------------------------------------------------------------${NC}"
	return "$git_status"
}

gitc()
{
	printf '%s\n' "${PEACH}------------------------------------------------------------${NC}"
	printf '%s' "$ORANGE"
	git checkout "$@"
	local git_status=$?
	printf '%s' "$NC"
	printf '%s\n' "${PEACH}------------------------------------------------------------${NC}"
	return "$git_status"
}

gitbr()
{
	printf '%s\n' "${PEACH}------------------------------------------------------------${NC}"
	printf '%s' "$ORANGE"
	git branch "$@"
	local git_status=$?
	printf '%s' "$NC"
	printf '%s\n' "${PEACH}------------------------------------------------------------${NC}"
	return "$git_status"
}

gitbra()
{
	printf '%s\n' "${PEACH}------------------------------------------------------------${NC}"
	printf '%s' "$ORANGE"
	git branch -a "$@"
	local git_status=$?
	printf '%s' "$NC"
	printf '%s\n' "${PEACH}------------------------------------------------------------${NC}"
	return "$git_status"
}

llog()
{
	printf '%s\n' "${PEACH}------------------------------------------------------------${NC}"
	printf '%s' "$ORANGE"
	git log | head -5 | tail -4 | head -3
	printf '%s' "$PINK"
	git log | head -5 | tail -1
	printf '%s' "$NC"
	printf '%s\n' "${PEACH}------------------------------------------------------------${NC}"
}

cmtr()
{
	printf '%s\n' "${RED}------------------------------------------------------------${NC}"
	printf '%s' "$ORANGE"
	git log | head -5 | tail -4 | head -3
	printf '%s' "$PINK"
	git log | head -5 | tail -1
	printf '%s' "$NC"
	printf '%s\n' "${RED}------------------------------------------------------------${NC}"
	git commit --amend -m "$*" || return
	printf '%s\n' "${GREEN}------------------------------------------------------------${NC}"
	printf '%s' "$ORANGE"
	git log | head -5 | tail -4 | head -3
	printf '%s' "$PINK"
	git log | head -5 | tail -1
	printf '%s' "$NC"
	printf '%s\n' "${GREEN}------------------------------------------------------------${NC}"
}

cmt()
{
	printf '%s\n' "${PEACH}### ${ORANGE}Git setup -> ${GREEN}SUCCESS${NC}"
	git add -A || {
		printf '%s\n' "${PEACH}### ${ORANGE}Add -> ${RED}FAIL${NC}"
		return 1
	}
	printf '%s\n' "${PEACH}### ${ORANGE}Add -> ${GREEN}SUCCESS${NC}"
	git commit -m "$*" || {
		printf '%s\n' "${PEACH}### ${ORANGE}Commit -> ${RED}FAIL${NC}"
		return 1
	}
	printf '%s\n' "${PEACH}### ${ORANGE}Commit -> ${GREEN}SUCCESS${NC}"
}

fullgit()
{
	printf '%s\n' "${PEACH}### ${ORANGE}Git setup -> ${GREEN}SUCCESS${NC}"
	git add -A || {
		printf '%s\n' "${PEACH}### ${ORANGE}Add -> ${RED}FAIL${NC}"
		return 1
	}
	printf '%s\n' "${PEACH}### ${ORANGE}Add -> ${GREEN}SUCCESS${NC}"
	git commit -m "$*" || {
		printf '%s\n' "${PEACH}### ${ORANGE}Commit -> ${RED}FAIL${NC}"
		return 1
	}
	printf '%s\n' "${PEACH}### ${ORANGE}Commit -> ${GREEN}SUCCESS${NC}"
	git push || {
		printf '%s\n' "${PEACH}### ${ORANGE}Push -> ${RED}FAIL${NC}"
		return 1
	}
	printf '%s\n' "${PEACH}### ${ORANGE}Push -> ${GREEN}SUCCESS${NC}"
	llog
}
